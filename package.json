    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@element-plus/icons-vue": "^2.3.2",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@vueuse/core": "^14.4.0",
    "@zyf_dsb/me-ui": "0.0.1",
    "ant-design-vue": "^4.2.6",
    "codemirror": "^6.0.2",
    "jsondiffpatch": "^0.7.6",
    "lodash": "^4.18.1",
    "nanoid": "^3.3.15",
    "nprogress": "^0.2.0",
