    "@vue/eslint-config-typescript": "^14.8.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.5.0",
    "eslint-plugin-vue": "^10.9.2",
    "gh-pages": "^6.3.0",
    "happy-dom": "^20.14.5",
    "less": "^4.6.6",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.11",
