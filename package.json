{
  "name": "vibepage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d dist",
    "test": "vitest run",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "type:check": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
